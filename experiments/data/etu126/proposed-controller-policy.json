{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CapacityRecoveryControlAndEvidence",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::etudefantasia/manabot/cohorts/etu103-recovery-v3-science/*",
        "arn:aws:s3:::etudefantasia/manabot/jobs/etu103-recovery-v3-science-0/*",
        "arn:aws:s3:::etudefantasia/manabot/jobs/etu103-recovery-v3-science-1/*",
        "arn:aws:s3:::etudefantasia/manabot/jobs/etu103-recovery-v3-science-2/*",
        "arn:aws:s3:::etudefantasia/manabot/jobs/etu103-recovery-v3-science-3/*",
        "arn:aws:s3:::etudefantasia/manabot/jobs/etu103-recovery-v3-science-4/*",
        "arn:aws:s3:::etudefantasia/manabot/jobs/etu103-recovery-v3-science-5/*"
      ]
    },
    {
      "Sid": "CapacityRecoveryMissingKeyAndInventory",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::etudefantasia"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "manabot/cohorts/etu103-recovery-v3-science/*",
            "manabot/jobs/etu103-recovery-v3-science-0/*",
            "manabot/jobs/etu103-recovery-v3-science-1/*",
            "manabot/jobs/etu103-recovery-v3-science-2/*",
            "manabot/jobs/etu103-recovery-v3-science-3/*",
            "manabot/jobs/etu103-recovery-v3-science-4/*",
            "manabot/jobs/etu103-recovery-v3-science-5/*"
          ]
        }
      }
    }
  ]
}
